# --- backend (FastAPI) ---
DATABASE_URL=sqlite+aiosqlite:///./receptra.db      # or postgresql+asyncpg://user:pass@db/receptra
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://your-tunnel.example.com      # where Vapi can reach /voice/vapi/events
CORS_ORIGINS=http://localhost:3000
SEED_DEMO=true

OPENAI_API_KEY=                 # empty = offline rule-based brain (demo/tests)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EXTRACT_MODEL=gpt-4o

VAPI_API_KEY=
VAPI_PUBLIC_KEY=                # enables "Talk to it" in the browser
VAPI_WEBHOOK_SECRET=            # set the same value as the server secret in Vapi

TWILIO_ACCOUNT_SID=             # empty = SMS/WhatsApp are stored as "simulated"
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
